<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netcoreapp2.0 is out of support and its runtime is no longer installable, so the suite
         could not be executed at all. net8.0 is the oldest LTS that still runs. -->
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GooglePay.PaymentDataCryptography\GooglePay.PaymentDataCryptography.csproj">
      <Name>GooglePay.PaymentDataCryptography</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="wycheproof\testvectors\ecdh_secp256r1_test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
